{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eoinedge.local/schemas/code-target.schema.json",
  "title": "Code Target",
  "type": "object",
  "required": ["target", "profileId"],
  "properties": {
    "target": {
      "type": "string",
      "enum": ["arduino-basex", "ev3dev-python", "pybricks-python", "spike-stock", "nxt-direct", "rcx-bridge"]
    },
    "profileId": { "type": "string" },
    "intent": { "type": "string" },
    "constraints": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
