{
  "id": "wedo2-kraz",
  "name": "Kraz",
  "family": "wedo2",
  "kit": "LEGO Education WeDo 2.0 45300",
  "robotKind": "animal_action",
  "crossGenNotes": "Animal robot with motion trigger. Port A motor for body action, Port B motion sensor.",
  "controller": {
    "model": "LPF2 Smart Hub 2 I/O (WeDo 2.0 Smart Hub 45301)",
    "firmware": "wedo2-hub-or-pybricks-cityhub",
    "connection": ["ble"]
  },
  "ports": {
    "A": { "kind": "motor",  "part": "wedo2-medium-motor",  "role": "body_action" },
    "B": { "kind": "sensor", "part": "wedo2-motion-sensor", "role": "motion_trigger" }
  },
  "sensors": [
    { "kind": "motion",       "source": "Port.B" },
    { "kind": "tilt",         "source": "hub-builtin" },
    { "kind": "accelerometer","source": "hub-builtin" }
  ],
  "programTargets": ["wedo2-micropython", "pybricks-city"],
  "notes": "WeDo 2.0 App available until July 31 2026. For continued programming after EOL, flash Pybricks CityHub firmware.",
  "license": "CC-BY-4.0"
}
