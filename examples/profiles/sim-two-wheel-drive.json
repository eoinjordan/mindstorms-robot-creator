{
  "id": "sim-two-wheel-drive",
  "name": "Simulated Two Wheel Drive Base",
  "family": "m5stack-basex",
  "robotKind": "two_wheel_drive",
  "controller": {
    "model": "M5Stack Core2 + BaseX",
    "firmware": "arduino",
    "connection": ["usb-serial", "ble", "wifi"]
  },
  "ports": {
    "A": { "kind": "motor", "part": "ev3-large", "role": "left_drive" },
    "B": { "kind": "motor", "part": "ev3-large", "role": "right_drive" }
  },
  "sensors": [
    { "kind": "imu", "source": "controller" }
  ],
  "simulator": {
    "speedScale": 5.5,
    "inertia": 0.3
  },
  "programTargets": ["arduino-basex"],
  "license": "CC-BY-4.0"
}
