{
  "name": "mindstorms-robot-creator",
  "version": "0.4.2",
  "description": "Build, code, and control LEGO MINDSTORMS robots with AI. Browser app, desktop installer, Android app, and MCP server.",
  "author": "Eoin Jordan",
  "main": "server.js",
  "type": "commonjs",
  "bin": {
    "mindstorms-robot-creator": "cli.js",
    "mindstorms-robot-creator-server": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "mcp": "node mcp-server.js",
    "cli": "node cli.js",
    "check": "node --check server.js && node --check cli.js && node --check mcp-server.js",
    "test": "node --test tests/*.test.js",
    "smoke": "node scripts/smoke.js",
    "manuals:51515": "python scripts/extract-51516-manuals.py",
    "android:sync-51515": "node scripts/sync-android-51515-assets.js",
    "android:sync-design": "node scripts/sync-android-design-docs.js",
    "android:assemble": "cd android/robot-inventor-app && gradlew.bat :app:assembleDebug",
    "icons:generate": "node scripts/generate-icons.js",
    "electron:dev": "electron electron/main.js",
    "electron:build": "electron-builder --config electron/builder.config.cjs",
    "electron:build:win": "electron-builder --win --config electron/builder.config.cjs",
    "electron:build:mac": "electron-builder --mac --config electron/builder.config.cjs",
    "electron:build:linux": "electron-builder --linux --config electron/builder.config.cjs",
    "screenshot": "node scripts/screenshot-ui.js",
    "screenshot:ci": "node scripts/screenshot-ui.js --out screencaps/ci",
    "demo": "node scripts/record-demos.js",
    "demo:ci": "cross-env CI=1 node scripts/record-demos.js --out screencaps/ci",
    "prepublishOnly": "npm test",
    "release": "npm version patch && git push --follow-tags"
  },
  "files": [
    "server.js",
    "mcp-server.js",
    "cli.js",
    "adapters/",
    "schemas/",
    "examples/",
    "web-app/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "lego",
    "mindstorms",
    "robots",
    "ai",
    "robotics",
    "edge-impulse",
    "pybricks",
    "mcp",
    "tinyml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eoinjordan/mindstorms-robot-creator.git"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "playwright-chromium": "^1.59.1"
  }
}
